<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗（小布/Siri 式）：胶囊 + 展开卡片。胶囊常显，卡片在回复/错误时展开。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 胶囊：录音/识别状态，可拖动，点击停止录音或展开卡片 -->
    <TextView
        android:id="@+id/overlayCapsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_capsule_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/overlay_recording"
        android:textColor="@color/fairy_text"
        android:textSize="14sp" />

    <!-- 卡片：AI 回复文本 + 操作（复制 / 收起）
         最大高度兜底，防止长回复把卡片撑出屏幕（ScrollView 负责内部滚动） -->
    <LinearLayout
        android:id="@+id/overlayCard"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:maxHeight="380dp"
        android:background="@drawable/overlay_card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fairy_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- P3：长回复全文展示——卡片内 ScrollView 滚动，不截断（高度由代码按屏幕动态限制） -->
        <ScrollView
            android:id="@+id/overlayScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="260dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/overlayCardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fairy_text"
                android:textSize="14sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlayBtnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/overlay_btn_copy"
                android:textColor="@color/fairy_blue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/overlayBtnClose"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/overlay_btn_close"
                android:textColor="@color/fairy_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
