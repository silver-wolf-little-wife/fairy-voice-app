<?xml version="1.0" encoding="utf-8"?>
<!-- P3：对话页（千问风格） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fairy_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvChatStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textColor="@color/fairy_blue"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_ask_input"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="3"
            android:textColor="@color/fairy_text"
            android:textColorHint="#80E1F5FE" />

        <Button
            android:id="@+id/btnChatMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_mic" />

        <Button
            android:id="@+id/btnChatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_send_ask" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChatState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/voice_state_idle"
        android:textColor="#B0E1F5FE"
        android:textSize="12sp" />
</LinearLayout>
