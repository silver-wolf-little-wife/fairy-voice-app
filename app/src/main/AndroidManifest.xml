<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M4-1.2：悬浮窗（小布/Siri 式胶囊与卡片） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- M4-1.2：Android 16 QPR1+ 的 Live Updates（ColorOS 16 流体云）提升权限；
         非 QPR1 设备不认识此权限会忽略，无副作用 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- M4 语音闭环预留 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".FairyVoiceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FairyVoice"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: B 端 fairy-voice ws_server 仅提供 ws://（明文），
             targetSdk 28+ 默认禁止明文流量，不开此开关则 ws:// 连接会被 OkHttp
             在发起 TCP 前直接拒绝，表现为无限重连、永远卡"连接中"。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- M4-1.2：悬浮窗 + 录音 + 流体云/Live Updates 前台服务（随「启动连接」常驻，
             唤醒时通过 action 控制，避免后台启动 FGS 限制） -->
        <service
            android:name=".service.FairyOverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".wake.WakeKeyService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 控制中心磁贴：OPPO 等无系统按键映射 ROM 的替代唤醒入口 -->
        <service
            android:name=".wake.FairyVoiceTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 录音分享导出：FileProvider 授权 URI，仅暴露 filesDir/recordings（见 res/xml/file_paths.xml） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
